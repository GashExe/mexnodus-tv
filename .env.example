# ─────────────────────────────────────────────────────────────────────────────
# MexNodus TV — variables de entorno
# Copia este archivo a .env.local (local) y configúralo también en Vercel.
# NUNCA subas .env.local. Los secretos van SOLO del lado servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (público — seguro para el navegador) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase (SECRETO — solo servidor, jamás en el frontend) ──
# Usada por API routes/admin para operaciones privilegiadas y por el worker.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── TMDB (SECRETO — solo servidor) ──
# Token v4 (Bearer). El catálogo se sincroniza desde el servidor; el token
# nunca se expone al cliente. Sin esto, la app usa datos mock.
TMDB_ACCESS_TOKEN=your-tmdb-v4-read-access-token
# Opcional: idioma/región por defecto para las consultas a TMDB.
TMDB_DEFAULT_LANGUAGE=es-MX
TMDB_DEFAULT_REGION=MX

# ── AniList (opcional, sin auth para lecturas públicas) ──
# No requiere clave para la API pública de GraphQL. Bandera para activar.
ANILIST_ENABLED=false

# ── Worker externo de validación (futuro) ──
# Clave compartida que el worker externo usará para reclamar trabajos de la
# cola. NO es necesaria para la primera versión (validación simulada).
VALIDATION_WORKER_SECRET=change-me-shared-secret

# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
